{
  "name": "zapfacil",
  "version": "2.0.0",
  "description": "WhatsApp automation with Electron - Modern architecture with SOLID principles",
  "main": "dist/main/index.js",
  "homepage": "./",
  "author": "ZapFacil Team",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently \"npm run dev:react\" \"npm run dev:electron\"",
    "dev:electron": "npm run build:electron && cross-env NODE_ENV=development electron .",
    "dev:react": "vite",
    "clean": "node scripts/clean-build.js",
    "build": "npm run clean && npm run build:react && npm run build:electron",
    "build:react": "vite build",
    "build:electron": "tsc --module commonjs --types jest,react,selenium-webdriver",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:mac": "npm run build && electron-builder --mac",
    "package:linux": "npm run build && electron-builder --linux",
    "package:beta": "npm run prerelease && npm run build && electron-builder --publish never",
    "package:publish": "npm run build && electron-builder --publish always",
    "build:assets": "node scripts/build/optimize-assets.js",
    "release:manifest": "node scripts/build/generate-manifest.js",
    "release:changelog": "node scripts/release/generate-changelog.js",
    "release:bump": "node scripts/release/bump-version.js",
    "release:prepare": "npm run release:changelog && npm run release:manifest",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --coverageReporters=text-summary --coverageReporters=html",
    "test:e2e": "jest --testPathPattern=e2e --detectOpenHandles",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:report": "node scripts/test/coverage-report.js",
    "test:all": "node scripts/test/run-tests.js all",
    "lint": "eslint src/ --ext .ts,.tsx",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "prerelease": "npm run lint && npm run type-check && npm run test:ci",
    "release": "npm run prerelease && npm run package:publish",
    "hooks:install": "node scripts/hooks/install-hooks.js",
    "hooks:precommit": "node scripts/hooks/pre-commit.js"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "axios": "^1.4.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "electron-is-dev": "^3.0.1",
    "electron-updater": "^6.8.5",
    "lucide-react": "^0.400.0",
    "recharts": "^2.10.0",
    "selenium-webdriver": "^4.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/jest": "^29.5.11",
    "@types/react": "^19.2.14",
    "@types/selenium-webdriver": "^4.35.5",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^42.0.0",
    "electron-builder": "^26.10.0",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "postcss": "^8.4.32",
    "postcss-nesting": "^12.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.11"
  },
  "build": {
    "appId": "com.zapfacil.app",
    "productName": "ZapFacil",
    "files": [
      "dist/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ZapFacil"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "hennriq",
      "repo": "zapfacil"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
